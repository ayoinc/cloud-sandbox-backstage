{%- set cosmos = values.enableDatabase and values.databaseType == 'nosql' -%}
{%- set sql = values.enableDatabase and values.databaseType == 'sql' -%}
# Data services the function uses: database, cache and object storage.
{%- if not (values.enableDatabase or values.enableCache or values.enableStorage) %}
# None was selected for this API.
{%- endif %}
{%- if cosmos %}

resource "azurerm_cosmosdb_account" "main" {
  name                = "cosmos-${var.project_name}-${local.environment_short}-${local.suffix}"
  resource_group_name = module.resource_group.name
  location            = module.resource_group.location
  offer_type          = "Standard"
  kind                = "GlobalDocumentDB"

  # Data access needs an Entra ID identity with a Cosmos DB role; account keys
  # are rejected.
  local_authentication_enabled = false
  minimal_tls_version          = "Tls12"

  capabilities {
    name = "EnableServerless"
  }

  consistency_policy {
    consistency_level = "Session"
  }

  geo_location {
    location          = module.resource_group.location
    failover_priority = 0
  }

  tags = local.tags

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_cosmosdb_sql_database" "main" {
  name                = "app"
  resource_group_name = module.resource_group.name
  account_name        = azurerm_cosmosdb_account.main.name

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_cosmosdb_sql_container" "items" {
  name                = "items"
  resource_group_name = module.resource_group.name
  account_name        = azurerm_cosmosdb_account.main.name
  database_name       = azurerm_cosmosdb_sql_database.main.name
  partition_key_paths = ["/id"]

  lifecycle {
    prevent_destroy = true
  }
}

# Built-in role "Cosmos DB Built-in Data Contributor".
resource "azurerm_cosmosdb_sql_role_assignment" "function" {
  for_each = local.function_principal_ids

  resource_group_name = module.resource_group.name
  account_name        = azurerm_cosmosdb_account.main.name
  role_definition_id  = "${azurerm_cosmosdb_account.main.id}/sqlRoleDefinitions/00000000-0000-0000-0000-000000000002"
  principal_id        = each.value
  scope               = azurerm_cosmosdb_account.main.id
}
{%- endif %}
{%- if sql %}

locals {
  sql_database_name = "app"
}

resource "random_password" "sql_administrator" {
  length           = 32
  special          = true
  override_special = "!#%*-_=+"
  min_lower        = 1
  min_upper        = 1
  min_numeric      = 1
  min_special      = 1
}

module "sql" {
  source = "git::https://github.com/ayoinc/cloud-sandbox-backstage.git//catalog/terraform-modules/azure/resources/database/sql-database?ref=83f9ff7222d2731d5cc0da4ab1fc1f7c46da3693"

  resource_group_name = module.resource_group.name
  location            = module.resource_group.location
  project             = var.project_name
  environment         = var.environment
  tags                = local.tags

  administrator_login    = var.sql_administrator_login
  administrator_password = random_password.sql_administrator.result

  azuread_administrator = {
    login_username = var.sql_entra_admin_name
    object_id      = var.sql_entra_admin_object_id != "" ? var.sql_entra_admin_object_id : data.azurerm_client_config.current.object_id
  }

  # The function plan has no virtual network: the function reaches the server
  # on its public endpoint through the "allow Azure services" firewall rule.
  public_network_access_enabled = true
  allow_azure_services          = true

  databases = {
    (local.sql_database_name) = {
      # General Purpose serverless, one vCore at most, paused after an idle hour.
      sku_name                    = "GP_S_Gen5_1"
      min_capacity                = 0.5
      auto_pause_delay_in_minutes = 60
      max_size_gb                 = var.sql_max_size_gb
      storage_account_type        = "Local"
    }
  }
}

# Holds the generated SQL administrator password. The pipeline runs on hosted
# runners without fixed addresses, so the vault cannot deny public network
# access; reading a secret still needs an access policy.
#trivy:ignore:AVD-AZU-0013
resource "azurerm_key_vault" "main" {
  name                       = "kv${local.compact}${local.suffix}"
  resource_group_name        = module.resource_group.name
  location                   = module.resource_group.location
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  sku_name                   = "standard"
  rbac_authorization_enabled = false
  purge_protection_enabled   = true
  soft_delete_retention_days = 7
  tags                       = local.tags

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_key_vault_access_policy" "deployer" {
  key_vault_id = azurerm_key_vault.main.id
  tenant_id    = data.azurerm_client_config.current.tenant_id
  object_id    = data.azurerm_client_config.current.object_id

  secret_permissions = ["Get", "List", "Set", "Delete", "Recover"]
}

resource "azurerm_key_vault_secret" "sql_administrator_password" {
  name         = "sql-administrator-password"
  key_vault_id = azurerm_key_vault.main.id
  value        = random_password.sql_administrator.result
  content_type = "password"

  depends_on = [azurerm_key_vault_access_policy.deployer]

  lifecycle {
    prevent_destroy = true
  }
}
{%- endif %}
{%- if values.enableCache %}

resource "azurerm_managed_redis" "main" {
  name                      = "redis-${local.name}-${local.suffix}"
  resource_group_name       = module.resource_group.name
  location                  = module.resource_group.location
  sku_name                  = var.redis_sku
  high_availability_enabled = var.environment == "production"

  default_database {
    # Clients authenticate with Entra ID; access keys are switched off.
    access_keys_authentication_enabled = false
    client_protocol                    = "Encrypted"
    eviction_policy                    = "VolatileLRU"

    # One endpoint for all shards, so clients need no cluster support.
    clustering_policy = "EnterpriseCluster"
  }

  tags = local.tags
}

resource "azurerm_managed_redis_access_policy_assignment" "function" {
  for_each = local.function_principal_ids

  managed_redis_id = azurerm_managed_redis.main.id
  object_id        = each.value
}
{%- endif %}
{%- if values.enableStorage %}

# Application data. The function plan has no virtual network, so the account
# cannot deny public network access; account keys are switched off and every
# request needs an Entra ID role.
#trivy:ignore:AVD-AZU-0012
resource "azurerm_storage_account" "data" {
  name                            = "st${local.compact}da${local.suffix}"
  resource_group_name             = module.resource_group.name
  location                        = module.resource_group.location
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  account_kind                    = "StorageV2"
  min_tls_version                 = "TLS1_2"
  https_traffic_only_enabled      = true
  allow_nested_items_to_be_public = false
  shared_access_key_enabled       = false
  default_to_oauth_authentication = true
  tags                            = local.tags

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_storage_container" "data" {
  name                  = "data"
  storage_account_id    = azurerm_storage_account.data.id
  container_access_type = "private"

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_role_assignment" "function_blob_data" {
  for_each = local.function_principal_ids

  scope                = azurerm_storage_container.data.id
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = each.value
  principal_type       = "ServicePrincipal"
}
{%- endif %}

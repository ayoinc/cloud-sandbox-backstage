{%- set slots = values.deploymentStrategy in ['canary', 'linear'] -%}
{%- set cosmos = values.enableDatabase and values.databaseType == 'nosql' -%}
{%- set sql = values.enableDatabase and values.databaseType == 'sql' -%}
{%- set insights = values.enableTracing or values.enableMetrics -%}
# tflint-ignore-file: azurerm_resources_missing_prevent_destroy
# The storage in this file holds host state and deployment packages, no
# application data, so it is not protected against destruction.

locals {
  # host.json "functionTimeout", written as hh:mm:ss.
  function_timeout = format(
    "%02d:%02d:%02d",
    floor(var.function_timeout_seconds / 3600),
    floor(var.function_timeout_seconds % 3600 / 60),
    var.function_timeout_seconds % 60,
  )

  function_app_settings = merge(
    {
      AzureFunctionsJobHost__functionTimeout = local.function_timeout
    },
{%- if slots %}
    {
      WEBSITE_RUN_FROM_PACKAGE = "1"
    },
{%- endif %}
{%- if insights and not values.enableTracing %}
    {
      AzureFunctionsJobHost__logging__applicationInsights__enableDependencyTracking                               = "false"
      AzureFunctionsJobHost__logging__applicationInsights__httpAutoCollectionOptions__enableW3CDistributedTracing = "false"
    },
{%- endif %}
{%- if cosmos %}
    {
      COSMOS_ENDPOINT  = azurerm_cosmosdb_account.main.endpoint
      COSMOS_DATABASE  = azurerm_cosmosdb_sql_database.main.name
      COSMOS_CONTAINER = azurerm_cosmosdb_sql_container.items.name
    },
{%- endif %}
{%- if sql %}
    {
      SQL_SERVER   = module.sql.server_fqdn
      SQL_DATABASE = local.sql_database_name
    },
{%- endif %}
{%- if values.enableCache %}
    {
      REDIS_HOST = azurerm_managed_redis.main.hostname
      REDIS_PORT = tostring(azurerm_managed_redis.main.default_database[0].port)
    },
{%- endif %}
{%- if values.enableStorage %}
    {
      STORAGE_BLOB_ENDPOINT  = azurerm_storage_account.data.primary_blob_endpoint
      STORAGE_CONTAINER_NAME = azurerm_storage_container.data.name
    },
{%- endif %}
    var.function_app_settings,
  )
{%- if slots %}

  function_app_id       = azurerm_linux_function_app.main.id
  function_app_name     = azurerm_linux_function_app.main.name
  function_app_hostname = azurerm_linux_function_app.main.default_hostname

  # Each slot has its own managed identity; both get the same data access.
  function_principal_ids = {
    production = azurerm_linux_function_app.main.identity[0].principal_id
    staging    = azurerm_linux_function_app_slot.staging.identity[0].principal_id
  }
{%- else %}

  function_app_id       = azurerm_function_app_flex_consumption.main.id
  function_app_name     = azurerm_function_app_flex_consumption.main.name
  function_app_hostname = azurerm_function_app_flex_consumption.main.default_hostname

  function_principal_ids = {
    production = azurerm_function_app_flex_consumption.main.identity[0].principal_id
  }
{%- endif %}
}

# Storage the Functions host uses for its own state{% if not slots %} and for the deployed package{% endif %}.
# The function plan has no virtual network, so the account cannot deny public
# network access; requests still need the account key or an Entra ID role.
#trivy:ignore:AVD-AZU-0012
resource "azurerm_storage_account" "function" {
  name                            = "st${local.compact}fn${local.suffix}"
  resource_group_name             = module.resource_group.name
  location                        = module.resource_group.location
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  account_kind                    = "StorageV2"
  min_tls_version                 = "TLS1_2"
  https_traffic_only_enabled      = true
  allow_nested_items_to_be_public = false
  tags                            = local.tags
}
{%- if slots %}

# Deployment slots need a plan that supports them: Elastic Premium.
resource "azurerm_service_plan" "function" {
  name                         = "asp-${local.name}"
  resource_group_name          = module.resource_group.name
  location                     = module.resource_group.location
  os_type                      = "Linux"
  sku_name                     = var.premium_plan_sku
  maximum_elastic_worker_count = var.function_maximum_instance_count
  tags                         = local.tags
}

resource "azurerm_linux_function_app" "main" {
  name                = "func-${local.compact}-${local.suffix}"
  resource_group_name = module.resource_group.name
  location            = module.resource_group.location
  service_plan_id     = azurerm_service_plan.function.id

  storage_account_name       = azurerm_storage_account.function.name
  storage_account_access_key = azurerm_storage_account.function.primary_access_key

  functions_extension_version = "~4"
  https_only                  = true
  app_settings                = local.function_app_settings

  identity {
    type = "SystemAssigned"
  }

  site_config {
    minimum_tls_version                    = "1.2"
    http2_enabled                          = true
    ftps_state                             = "Disabled"
    application_insights_connection_string = local.application_insights_connection_string

    application_stack {
{%- if values.runtime == 'python313' %}
      python_version = "3.13"
{%- elif values.runtime == 'dotnet10' %}
      dotnet_version              = "10.0"
      use_dotnet_isolated_runtime = true
{%- elif values.runtime == 'java21' %}
      java_version = "21"
{%- elif values.runtime == 'go126' %}
      # Go runs as a custom handler: the package carries the compiled binary.
      use_custom_runtime = true
{%- else %}
      node_version = "24"
{%- endif %}
    }
  }

  tags = local.tags
}

# New versions are deployed to this slot, receive a share of the traffic from
# the gateway and are then swapped into production.
resource "azurerm_linux_function_app_slot" "staging" {
  name            = "staging"
  function_app_id = azurerm_linux_function_app.main.id

  storage_account_name       = azurerm_storage_account.function.name
  storage_account_access_key = azurerm_storage_account.function.primary_access_key

  functions_extension_version = "~4"
  https_only                  = true
  app_settings                = local.function_app_settings

  identity {
    type = "SystemAssigned"
  }

  site_config {
    minimum_tls_version                    = "1.2"
    http2_enabled                          = true
    ftps_state                             = "Disabled"
    application_insights_connection_string = local.application_insights_connection_string

    application_stack {
{%- if values.runtime == 'python313' %}
      python_version = "3.13"
{%- elif values.runtime == 'dotnet10' %}
      dotnet_version              = "10.0"
      use_dotnet_isolated_runtime = true
{%- elif values.runtime == 'java21' %}
      java_version = "21"
{%- elif values.runtime == 'go126' %}
      use_custom_runtime = true
{%- else %}
      node_version = "24"
{%- endif %}
    }
  }

  tags = local.tags
}
{%- else %}

resource "azurerm_storage_container" "deployments" {
  name                  = "deployments"
  storage_account_id    = azurerm_storage_account.function.id
  container_access_type = "private"
}

resource "azurerm_service_plan" "function" {
  name                = "asp-${local.name}"
  resource_group_name = module.resource_group.name
  location            = module.resource_group.location
  os_type             = "Linux"
  sku_name            = "FC1"
  tags                = local.tags
}

resource "azurerm_function_app_flex_consumption" "main" {
  name                = "func-${local.compact}-${local.suffix}"
  resource_group_name = module.resource_group.name
  location            = module.resource_group.location
  service_plan_id     = azurerm_service_plan.function.id

  storage_container_type      = "blobContainer"
  storage_container_endpoint  = "${azurerm_storage_account.function.primary_blob_endpoint}${azurerm_storage_container.deployments.name}"
  storage_authentication_type = "StorageAccountConnectionString"
  storage_access_key          = azurerm_storage_account.function.primary_access_key
{% if values.runtime == 'python313' %}
  runtime_name    = "python"
  runtime_version = "3.13"
{%- elif values.runtime == 'dotnet10' %}
  runtime_name    = "dotnet-isolated"
  runtime_version = "10.0"
{%- elif values.runtime == 'java21' %}
  runtime_name    = "java"
  runtime_version = "21"
{%- elif values.runtime == 'go126' %}
  # Go runs as a custom handler: the package carries the compiled binary.
  runtime_name    = "custom"
  runtime_version = "1.0"
{%- else %}
  runtime_name    = "node"
  runtime_version = "24"
{%- endif %}

  instance_memory_in_mb  = var.function_memory_mb
  maximum_instance_count = var.function_maximum_instance_count

  https_only      = true
  app_settings    = local.function_app_settings
  zip_deploy_file = var.function_package_path

  identity {
    type = "SystemAssigned"
  }

  site_config {
    minimum_tls_version                    = "1.2"
    http2_enabled                          = true
    application_insights_connection_string = local.application_insights_connection_string
  }

  tags = local.tags
}
{%- endif %}

{%- set runtime = values.runtime or 'nodejs24' -%}
{%- set apiType = 'rest' if values.apiType == 'rest' else ('graphql' if values.apiType == 'graphql' else 'http') -%}
{%- set authType = values.authType or 'none' -%}
{%- set interpreted = runtime == 'nodejs24' or runtime == 'python313' -%}
{%- set sql = values.enableDatabase and values.databaseType == 'sql' -%}
{%- set nosql = values.enableDatabase and not sql -%}
{%- set vpc = sql or values.enableCache -%}
{%- set keyAuthorizer = apiType == 'http' and authType == 'api-key' -%}
{%- set oidcAuthorizer = apiType == 'rest' and authType == 'oauth2' -%}
{%- set graphqlKey = apiType == 'graphql' and (authType == 'api-key' or authType == 'none') -%}
{%- set cloudfront = apiType == 'http' and values.enableWaf -%}
{%- set waf = values.enableWaf or (apiType == 'graphql' and values.enableThrottling) -%}
{%- set gradual = values.deploymentStrategy == 'canary' or values.deploymentStrategy == 'linear' -%}
{%- set modules = 'git::https://github.com/ayoinc/cloud-sandbox-backstage.git//catalog/terraform-modules/aws/resources' -%}
{%- set ref = '?ref=83f9ff7222d2731d5cc0da4ab1fc1f7c46da3693' -%}
# Log group of the function{% if values.enableMetrics %}, metric filters on its log lines{% endif %}{% if values.enableAlarms %} and the alarms of the function and the API{% endif %}.
module "monitoring" {
  source = "${{ modules }}/monitoring/cloudwatch${{ ref }}"

  project_name      = var.project_name
  environment       = var.environment
  log_group_name    = "/aws/lambda/${local.function_name}"
  retention_in_days = var.log_retention_days
  {%- if values.enableMetrics %}

  log_metric_filters = [
    {
      name             = "${local.name}-logged-errors"
      pattern          = "?ERROR ?Error ?Exception"
      metric_name      = "LoggedErrors"
      metric_namespace = local.metrics_namespace
      metric_value     = "1"
    },
    {
      name             = "${local.name}-timeouts"
      pattern          = "\"Task timed out\""
      metric_name      = "Timeouts"
      metric_namespace = local.metrics_namespace
      metric_value     = "1"
    },
  ]
  {%- endif %}
  {%- if values.enableAlarms %}

  alarms = [
    {
      name                = "${local.name}-function-errors"
      comparison_operator = "GreaterThanThreshold"
      evaluation_periods  = 1
      metric_name         = "Errors"
      namespace           = "AWS/Lambda"
      period              = 300
      statistic           = "Sum"
      threshold           = 0
      alarm_actions       = [module.alarm_topic.topic_arn]
      dimensions          = { FunctionName = local.function_name }
    },
    {
      name                = "${local.name}-function-throttles"
      comparison_operator = "GreaterThanThreshold"
      evaluation_periods  = 1
      metric_name         = "Throttles"
      namespace           = "AWS/Lambda"
      period              = 300
      statistic           = "Sum"
      threshold           = 0
      alarm_actions       = [module.alarm_topic.topic_arn]
      dimensions          = { FunctionName = local.function_name }
    },
    {
      name                = "${local.name}-api-5xx"
      comparison_operator = "GreaterThanThreshold"
      evaluation_periods  = 1
      metric_name         = "${{ '5xx' if apiType == 'http' else '5XXError' }}"
      namespace           = "${{ 'AWS/AppSync' if apiType == 'graphql' else 'AWS/ApiGateway' }}"
      period              = 300
      statistic           = "Sum"
      threshold           = 0
      alarm_actions       = [module.alarm_topic.topic_arn]
      dimensions          = local.api_metric_dimensions
    },
    {
      name                = "${local.name}-api-latency"
      comparison_operator = "GreaterThanThreshold"
      evaluation_periods  = 3
      metric_name         = "Latency"
      namespace           = "${{ 'AWS/AppSync' if apiType == 'graphql' else 'AWS/ApiGateway' }}"
      period              = 300
      statistic           = "Average"
      threshold           = var.alarm_latency_threshold_ms
      alarm_actions       = [module.alarm_topic.topic_arn]
      dimensions          = local.api_metric_dimensions
    },
  ]
  {%- endif %}
}
{%- if values.enableMetrics %}

locals {
  # Namespace of the metric filters and of the metrics the function publishes
  # itself; the function reads it from METRICS_NAMESPACE.
  metrics_namespace = "${var.project_name}/${var.environment}"
}
{%- endif %}
{%- if values.enableAlarms %}

locals {
  api_metric_dimensions = {
    {%- if apiType == 'http' %}
    ApiId = aws_apigatewayv2_api.this.id
    {%- elif apiType == 'rest' %}
    ApiName = aws_api_gateway_rest_api.this.name
    Stage   = aws_api_gateway_stage.this.stage_name
    {%- else %}
    GraphQLAPIId = aws_appsync_graphql_api.this.id
    {%- endif %}
  }
}

# Topic the alarms notify.
module "alarm_topic" {
  source = "${{ modules }}/messaging/sns${{ ref }}"

  project_name         = var.project_name
  environment          = var.environment
  topic_name           = "alarms"
  allowed_aws_services = ["cloudwatch.amazonaws.com"]
  subscriptions        = var.alarm_email == null ? [] : [{ protocol = "email", endpoint = var.alarm_email }]
}
{%- endif %}

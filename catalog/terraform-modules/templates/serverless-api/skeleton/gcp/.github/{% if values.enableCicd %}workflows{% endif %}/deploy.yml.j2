{%- set runtime = values.runtime or 'nodejs24' -%}
{%- set interpreted = runtime in ['nodejs24', 'python313'] -%}
{%- set auth = values.authType or 'jwt' -%}
{%- set directLb = values.enableWaf and auth == 'none' -%}
{%- set gateway = not directLb -%}
{%- set gatewayQuota = gateway and values.enableThrottling and auth == 'api-key' -%}
{%- set armorThrottle = values.enableWaf and values.enableThrottling and auth != 'api-key' -%}
{%- set sql = values.enableDatabase and values.databaseType == 'sql' -%}
{%- set nosql = values.enableDatabase and not sql -%}
{%- set strategy = values.deploymentStrategy or 'canary' -%}
{%- set region = values.gcpRegion or 'us-central1' -%}
name: Deploy
{% raw %}
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

env:
  TF_IN_AUTOMATION: 'true'
  TF_INPUT: '0'
  # Function package in Cloud Storage. Empty values keep the configuration's
  # defaults.
  TF_VAR_function_source_bucket: ${{ vars.FUNCTION_SOURCE_BUCKET }}
  TF_VAR_function_source_object: ${{ vars.FUNCTION_SOURCE_OBJECT }}{% endraw %}
{%- if auth == 'oauth2' %}{% raw %}
  TF_VAR_oauth2_issuer: ${{ vars.OAUTH2_ISSUER }}
  TF_VAR_oauth2_jwks_uri: ${{ vars.OAUTH2_JWKS_URI }}
  TF_VAR_oauth2_audiences: ${{ vars.OAUTH2_AUDIENCES }}{% endraw %}
{%- endif %}
{%- if values.enableWaf %}{% raw %}
  TF_VAR_load_balancer_domain: ${{ vars.LOAD_BALANCER_DOMAIN }}{% endraw %}
{%- endif %}
{%- if values.enableAlarms %}{% raw %}
  TF_VAR_alarm_email: ${{ vars.ALARM_EMAIL }}{% endraw %}
{%- endif %}
{%- if strategy != 'all-at-once' %}
  # Cloud Run service of the function, for the staged traffic shift.
  GCP_PROJECT_ID: ${{ values.gcpProjectId | dump }}
  GCP_REGION: ${{ region }}
  FUNCTION_NAME: ${{ values.projectName }}-${{ values.environment or 'dev' }}
{%- endif %}
{% raw %}
jobs:
  credentials:
    name: Deployment credentials
    runs-on: ubuntu-latest
    outputs:
      available: ${{ steps.check.outputs.available }}
    steps:
      - name: Check that an identity and a state bucket are configured
        id: check
        env:
          WORKLOAD_IDENTITY_PROVIDER: ${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER || vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          SERVICE_ACCOUNT: ${{ secrets.GCP_SERVICE_ACCOUNT || vars.GCP_SERVICE_ACCOUNT }}
          TF_STATE_BUCKET: ${{ vars.TF_STATE_BUCKET }}
        run: |
          if [ -n "$WORKLOAD_IDENTITY_PROVIDER" ] && [ -n "$SERVICE_ACCOUNT" ] && [ -n "$TF_STATE_BUCKET" ]; then
            echo "available=true" >> "$GITHUB_OUTPUT"
          else
            echo "available=false" >> "$GITHUB_OUTPUT"
            echo "::notice::Plan and apply are skipped until GCP_WORKLOAD_IDENTITY_PROVIDER, GCP_SERVICE_ACCOUNT and TF_STATE_BUCKET are configured."
          fi

  plan:
    name: Plan
    needs: credentials
    if: needs.credentials.outputs.available == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: google-github-actions/auth@v3
        with:
          workload_identity_provider: ${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER || vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.GCP_SERVICE_ACCOUNT || vars.GCP_SERVICE_ACCOUNT }}

      - uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.17.1

      - name: Initialise
        run: >
          terraform init
          -backend-config="bucket=${{ vars.TF_STATE_BUCKET }}"
          -backend-config="prefix=${{ github.event.repository.name }}"

      - name: Plan
        run: terraform plan -out=tfplan

      # build/ holds the function archive Terraform packaged during the plan;
      # the apply job uploads it from there.
      - uses: actions/upload-artifact@v7
        with:
          name: tfplan
          path: |
            tfplan
            build/

  apply:
    name: Apply
    needs: plan
    if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    environment: production
    steps:
      - uses: actions/checkout@v7

      - uses: google-github-actions/auth@v3
        with:
          workload_identity_provider: ${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER || vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.GCP_SERVICE_ACCOUNT || vars.GCP_SERVICE_ACCOUNT }}

      - uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.17.1

      - name: Initialise
        run: >
          terraform init
          -backend-config="bucket=${{ vars.TF_STATE_BUCKET }}"
          -backend-config="prefix=${{ github.event.repository.name }}"

      - uses: actions/download-artifact@v8
        with:
          name: tfplan{% endraw %}
{%- if strategy != 'all-at-once' %}{% raw %}

      - uses: google-github-actions/setup-gcloud@v3

      # A revision created by the apply takes no traffic while the service's
      # traffic is assigned to a named revision.
      - name: Keep traffic on the serving revision
        id: hold
        run: |
          service="$(gcloud run services list --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --filter "metadata.name=$FUNCTION_NAME" --format json)"
          serving="$(jq -r '.[0].status.traffic // [] | max_by(.percent // 0) | .revisionName // empty' <<<"$service")"
          follows_latest="$(jq -r '[.[0].status.traffic // [] | .[] | select(.latestRevision == true)] | length' <<<"$service")"
          if [ -n "$serving" ] && [ "$follows_latest" != "0" ]; then
            gcloud run services update-traffic "$FUNCTION_NAME" --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --to-revisions "$serving=100"
          fi
          echo "revision=$serving" >> "$GITHUB_OUTPUT"{% endraw %}
{%- endif %}
{% raw %}
      - name: Apply
        run: terraform apply tfplan{% endraw %}
{%- if strategy != 'all-at-once' %}{% raw %}

      - name: Shift traffic to the new revision in steps
        env:
          PREVIOUS: ${{ steps.hold.outputs.revision }}
          STEP_SECONDS: ${{ vars.ROLLOUT_STEP_SECONDS || '300' }}
        run: |
          current="$(gcloud run services describe "$FUNCTION_NAME" --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format 'value(status.latestReadyRevisionName)')"
          if [ -z "$PREVIOUS" ]; then
            echo "First deployment: $current serves all traffic."
            exit 0
          fi
          if [ "$PREVIOUS" != "$current" ]; then{% endraw %}
            for percent in ${{ '10' if strategy == 'canary' else '25 50 75' }}; do{% raw %}
              gcloud run services update-traffic "$FUNCTION_NAME" --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --to-revisions "$current=$percent,$PREVIOUS=$((100 - percent))"
              echo "$current serves $percent% of the traffic; waiting $STEP_SECONDS seconds."
              sleep "$STEP_SECONDS"
            done
          fi
          gcloud run services update-traffic "$FUNCTION_NAME" --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --to-latest{% endraw %}
{%- endif %}

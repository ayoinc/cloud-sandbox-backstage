name: Build Lambda package
description: Runs the unit tests of the function and writes build/lambda.zip

runs:
  using: composite
  steps:
    - uses: actions/setup-node@v7
      with:
        node-version: ${{ '22' if '22' in values.runtime else '24' }}

    - name: Run unit tests
      shell: bash
      run: npm test

    - name: Package the function
      shell: bash
      run: bash scripts/package.sh

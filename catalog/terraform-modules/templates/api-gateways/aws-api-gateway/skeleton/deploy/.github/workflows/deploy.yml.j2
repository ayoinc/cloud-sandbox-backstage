{% raw %}name: Deploy

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

env:
  TF_IN_AUTOMATION: 'true'
  TF_INPUT: '0'
{% endraw %}  AWS_REGION: ${{ values.awsRegion or 'us-east-1' }}
{% raw %}
jobs:
  credentials:
    name: Deployment credentials
    runs-on: ubuntu-latest
    outputs:
      available: ${{ steps.check.outputs.available }}
    steps:
      - name: Check that a role and a state bucket are configured
        id: check
        env:
          AWS_ROLE_ARN: ${{ secrets.AWS_ROLE_ARN || vars.AWS_ROLE_ARN }}
          TF_STATE_BUCKET: ${{ vars.TF_STATE_BUCKET }}
        run: |
          if [ -n "$AWS_ROLE_ARN" ] && [ -n "$TF_STATE_BUCKET" ]; then
            echo "available=true" >> "$GITHUB_OUTPUT"
          else
            echo "available=false" >> "$GITHUB_OUTPUT"
            echo "::notice::Plan and apply are skipped until AWS_ROLE_ARN and TF_STATE_BUCKET are configured (see docs/operations.md)."
          fi

  plan:
    name: Plan
    needs: credentials
    if: needs.credentials.outputs.available == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Test and package the function
        uses: ./.github/actions/build-lambda

      - uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN || vars.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.17.1

      - name: Initialise
        working-directory: infra
        run: >
          terraform init
          -backend-config="bucket=${{ vars.TF_STATE_BUCKET }}"
          -backend-config="key=${{ github.event.repository.name }}/terraform.tfstate"
          -backend-config="region=${{ vars.TF_STATE_REGION || env.AWS_REGION }}"
          -backend-config="use_lockfile=true"

      - name: Plan
        working-directory: infra
        run: terraform plan -out=tfplan

      # The plan refers to the packages by path and hash and to the provider
      # versions selected at init, so apply needs the same files.
      - uses: actions/upload-artifact@v7
        with:
          name: deployment
          path: |
            infra/tfplan
            infra/.terraform.lock.hcl
            build/
          include-hidden-files: true
          retention-days: 1

  apply:
    name: Apply
    needs: plan
    if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    environment: production
    steps:
      - uses: actions/checkout@v7

      - uses: actions/download-artifact@v8
        with:
          name: deployment

      - uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN || vars.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.17.1

      - name: Initialise
        working-directory: infra
        run: >
          terraform init
          -backend-config="bucket=${{ vars.TF_STATE_BUCKET }}"
          -backend-config="key=${{ github.event.repository.name }}/terraform.tfstate"
          -backend-config="region=${{ vars.TF_STATE_REGION || env.AWS_REGION }}"
          -backend-config="use_lockfile=true"

      - name: Apply
        working-directory: infra
        run: terraform apply tfplan

      - name: Show the API URL
        working-directory: infra
        run: echo "API URL $(terraform output -raw api_url)" >> "$GITHUB_STEP_SUMMARY"
{% endraw %}
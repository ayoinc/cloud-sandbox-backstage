# The nginx image fills in ${BACKEND_URL} from the environment when it starts.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # The API, served from the same origin as the pages.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Built assets carry a hash of their content in their name: they never change.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Every other address is a page of the single-page application.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}

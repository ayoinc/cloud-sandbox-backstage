# Copy to .env for local development: `npm run dev` reads it.

PORT=8080
DATABASE_URL=postgres://store:store@localhost:5432/store
{% if values.enableCaching %}
REDIS_URL=redis://localhost:6379
{% endif %}

# Bearer token of the admin API. Without it the admin API answers 503.
ADMIN_TOKEN=local-admin-token

# Feature switches. The defaults are in src/features.ts.
# FEATURE_PRODUCT_MANAGEMENT=true
# FEATURE_PAYMENTS=true
# FEATURE_SEARCH=true
# FEATURE_REVIEWS=true
# FEATURE_INVENTORY=true
# FEATURE_ANALYTICS=true
# FEATURE_CACHING=true

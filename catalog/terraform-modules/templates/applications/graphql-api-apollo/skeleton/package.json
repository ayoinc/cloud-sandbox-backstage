{
  "name": "${{ values.apiName }}",
  "version": "${{ values.apiVersion }}",
  "description": ${{ values.description | dump }},
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema/*.graphql dist/schema/",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema:print": "node --import tsx scripts/print-schema.ts",
    "token": "node --env-file-if-exists=.env --import tsx scripts/token.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/server-plugin-response-cache": "^5.0.0",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.9",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-graphql": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@prometheus-io/client": "^0.16.1",
{% if values.databaseType == 'sqlite' %}
    "better-sqlite3": "^13.0.3",
{% endif %}
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "knex": "^3.3.0",
{% if values.databaseType == 'mysql' %}
    "mysql2": "^3.24.6",
{% endif %}
{% if values.databaseType == 'postgresql' %}
    "pg": "^8.23.1",
{% endif %}
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}

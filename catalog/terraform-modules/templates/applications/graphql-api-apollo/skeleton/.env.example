# Copy to .env for local development: `npm run dev` and `npm run token` read it.
# Every variable is optional unless noted; docs/operations.md lists them all.

PORT=4000
{% if values.databaseType == 'postgresql' %}
DATABASE_URL=postgres://app:app@localhost:5432/app
{% elif values.databaseType == 'mysql' %}
DATABASE_URL=mysql://app:app@localhost:3306/app
{% else %}
DATABASE_URL=./data/app.db
{% endif %}
{% if values.enableAuth and values.authProvider == 'jwt' %}

# Required while authentication is on: the secret that signs and checks tokens.
JWT_SECRET=local-development-secret-change-me
{% elif values.enableAuth %}

# Required while authentication is on: your identity provider.
AUTH_ISSUER=https://your-tenant.example.com/
AUTH_AUDIENCE=${{ values.apiName }}
{% endif %}
{% if values.enableCache %}

# Without it, responses are cached in the memory of each process.
REDIS_URL=redis://localhost:6379
{% endif %}
{% if values.enableTracing %}

# Tracing starts once a collector is configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
{% endif %}

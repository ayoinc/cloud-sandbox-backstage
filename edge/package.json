{
  "name": "@internal/edge",
  "version": "0.0.0",
  "private": true,
  "description": "Cloud Sandbox on Cloudflare Workers: serves the app and a Backstage-compatible API backed by D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --secrets-file .prod.vars",
    "types": "wrangler types --strict-vars false",
    "tsc": "wrangler types --strict-vars false && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cloud-sandbox --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloud-sandbox --remote",
    "catalog:sync": "node scripts/pipeline/sync-catalog.mjs",
    "template:run": "node scripts/pipeline/run-template.mjs",
    "template:dry-run": "node scripts/pipeline/dry-run.mjs",
    "template:check": "node scripts/pipeline/check-templates.mjs",
    "verify": "node scripts/compare-with-backend.mjs",
    "verify:organisations": "node scripts/check-organisations.mjs",
    "verify:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@backstage/config": "backstage:^",
    "@backstage/integration": "backstage:^",
    "@backstage/plugin-techdocs-node": "backstage:^",
    "better-sqlite3": "^12.0.0",
    "mime-types": "^3.0.0",
    "typescript": "~5.8.0",
    "wrangler": "^4.150.0"
  }
}

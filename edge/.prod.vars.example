# Copy to .prod.vars and fill in. `yarn workspace @internal/edge deploy`
# uploads these to Cloudflare, where they are stored as secrets; values already
# stored there and not listed here are kept.
GITHUB_CLIENT_ID=
# GitHub logins allowed to sign in, comma-separated
GITHUB_ALLOWED_USERS=
GOOGLE_CLIENT_ID=
# Google accounts allowed to sign in: exact emails, and whole domains
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=
# Optional. Portal admins, comma-separated: jane or user:default/jane. While
# empty and no admin was added in the portal, the first person to sign in is admin
PORTAL_ADMINS=
# Optional. The address the privacy notice tells people to write to
PORTAL_CONTACT_EMAIL=

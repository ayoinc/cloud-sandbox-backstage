# Copy to .dev.vars for local development.
# Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=
# Sign-in clients and who may sign in. Leave empty to use guest sign-in only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=
# What pipeline scripts send to /api/pipeline. Generate with: openssl rand -hex 32
PIPELINE_TOKEN=
# GitHub token that starts the template workflow and reads Actions runs.
# Leave empty to work without GitHub: templates then fail with that reason.
PORTAL_GITHUB_TOKEN=
# Local use only, ignored by a deployed Worker. With "true" a dry run in the
# template editor starts no workflow: the Worker prints the command that runs
# it on this machine and waits for it
LOCAL_DRY_RUN_WITHOUT_GITHUB=
# Optional. Portal admins, comma-separated: jane or user:default/jane. While
# empty and no admin was added in the portal, the first person to sign in
# (guests excepted) is admin
PORTAL_ADMINS=
# Guest sign-in for local use only
GUEST_AUTH_ENABLED=true

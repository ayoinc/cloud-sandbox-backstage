# Build context for the multi-stage Dockerfile: sources are built inside the image,
# so only host build output, dependencies and local/secret files are excluded.
.git
.github
.yarn/cache
.yarn/install-state.gz
node_modules
**/node_modules
dist-types
packages/*/dist
plugins/*/dist
*.tsbuildinfo

# Local config and secrets
*.local.yaml
.env
.env.*
!.env.example

# Generated output
techdocs-output
**/site
coverage
playwright-report
test-results
*.log
backups

# Editor / tooling
.idea
.vscode
*.swp
.devbox
.eslintcache

locals {
  cdn_enabled = var.enable_cdn && var.enable_storage

  # Front Door reaches the storage account over a private link, and managed
  # firewall rules run on the same tier: both need the Premium SKU.
  front_door_sku = "Premium_AzureFrontDoor"

  # Identifies the private link request of Front Door on the storage account.
  front_door_link_message = "Front Door origin of ${var.name_prefix}"

  waf_id = !var.enable_waf ? null : (
    local.cdn_enabled ? azurerm_cdn_frontdoor_firewall_policy.this[0].id : azurerm_web_application_firewall_policy.regional[0].id
  )

  # Approves the pending private endpoint connection that Front Door opened
  # on the storage account. The connection name is generated by Azure, so the
  # template looks it up and hands it to a nested deployment.
  front_door_link_approval_template = jsonencode({
    "$schema"      = local.arm_template_schema
    contentVersion = "1.0.0.0"
    parameters = {
      storageAccountName = { type = "string" }
      requestMessage     = { type = "string" }
      originId           = { type = "string" }
    }
    resources = [{
      type       = "Microsoft.Resources/deployments"
      apiVersion = "2022-09-01"
      name       = "[concat(deployment().name, '-connections')]"
      properties = {
        mode                        = "Incremental"
        expressionEvaluationOptions = { scope = "inner" }
        parameters = {
          storageAccountName = { value = "[parameters('storageAccountName')]" }
          requestMessage     = { value = "[parameters('requestMessage')]" }
          connections = {
            value = "[reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').privateEndpointConnections]"
          }
        }
        template = {
          "$schema"      = local.arm_template_schema
          contentVersion = "1.0.0.0"
          parameters = {
            storageAccountName = { type = "string" }
            requestMessage     = { type = "string" }
            connections        = { type = "array" }
          }
          resources = [{
            copy = {
              name  = "connections"
              count = "[length(parameters('connections'))]"
            }
            condition  = "[equals(parameters('connections')[copyIndex()].properties.privateLinkServiceConnectionState.description, parameters('requestMessage'))]"
            type       = "Microsoft.Storage/storageAccounts/privateEndpointConnections"
            apiVersion = "2023-05-01"
            name       = "[concat(parameters('storageAccountName'), '/', last(split(parameters('connections')[copyIndex()].id, '/')))]"
            properties = {
              privateLinkServiceConnectionState = {
                status      = "Approved"
                description = "[parameters('requestMessage')]"
              }
            }
          }]
        }
      }
    }]
  })
}

# -----------------------------------------------------------------------------
# Front Door in front of the storage account
# -----------------------------------------------------------------------------

# The files in this container are published to the internet through Front
# Door, which reads them without credentials. The firewall of the storage
# account denies every public address, so that read access is only usable
# over the private link of Front Door and from inside the virtual network.
# trivy:ignore:AVD-AZU-0007
resource "azurerm_storage_container" "cdn" {
  count = local.cdn_enabled ? 1 : 0

  name                  = local.cdn_container_name
  storage_account_id    = azurerm_storage_account.this[0].id
  container_access_type = "blob"
}

resource "azurerm_cdn_frontdoor_profile" "this" {
  count = local.cdn_enabled ? 1 : 0

  name                = "${var.name_prefix}-cdn"
  resource_group_name = azurerm_resource_group.this.name
  sku_name            = local.front_door_sku

  tags = local.tags
}

resource "azurerm_cdn_frontdoor_endpoint" "this" {
  count = local.cdn_enabled ? 1 : 0

  name                     = "${var.name_prefix}-${local.suffix}"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.this[0].id

  tags = local.tags
}

resource "azurerm_cdn_frontdoor_origin_group" "storage" {
  count = local.cdn_enabled ? 1 : 0

  name                     = "storage"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.this[0].id

  load_balancing {
    sample_size                 = 4
    successful_samples_required = 3
  }
}

resource "azurerm_cdn_frontdoor_origin" "storage" {
  count = local.cdn_enabled ? 1 : 0

  name                          = "storage"
  cdn_frontdoor_origin_group_id = azurerm_cdn_frontdoor_origin_group.storage[0].id
  enabled                       = true

  host_name                      = azurerm_storage_account.this[0].primary_blob_host
  origin_host_header             = azurerm_storage_account.this[0].primary_blob_host
  certificate_name_check_enabled = true

  private_link {
    request_message        = local.front_door_link_message
    target_type            = "blob"
    location               = azurerm_storage_account.this[0].location
    private_link_target_id = azurerm_storage_account.this[0].id
  }
}

# HTTP requests are redirected to HTTPS, and Front Door always talks HTTPS to
# the storage account.
resource "azurerm_cdn_frontdoor_route" "storage" {
  count = local.cdn_enabled ? 1 : 0

  name                          = "storage"
  cdn_frontdoor_endpoint_id     = azurerm_cdn_frontdoor_endpoint.this[0].id
  cdn_frontdoor_origin_group_id = azurerm_cdn_frontdoor_origin_group.storage[0].id
  cdn_frontdoor_origin_ids      = [azurerm_cdn_frontdoor_origin.storage[0].id]
  cdn_frontdoor_origin_path     = "/${azurerm_storage_container.cdn[0].name}"

  patterns_to_match      = ["/*"]
  supported_protocols    = ["Http", "Https"]
  https_redirect_enabled = true
  forwarding_protocol    = "HttpsOnly"
  link_to_default_domain = true

  cache {
    query_string_caching_behavior = "IgnoreQueryString"
    compression_enabled           = true
    content_types_to_compress = [
      "application/javascript",
      "application/json",
      "application/xml",
      "image/svg+xml",
      "text/css",
      "text/html",
      "text/javascript",
      "text/plain",
    ]
  }
}

resource "azurerm_resource_group_template_deployment" "front_door_link_approval" {
  count = local.cdn_enabled ? 1 : 0

  name                = "${var.name_prefix}-cdn-link-approval"
  resource_group_name = azurerm_resource_group.this.name
  deployment_mode     = "Incremental"
  template_content    = local.front_door_link_approval_template

  # The origin ID is not used by the template: a new origin opens a new
  # connection, and the changed parameter runs the approval again.
  parameters_content = jsonencode({
    storageAccountName = { value = azurerm_storage_account.this[0].name }
    requestMessage     = { value = local.front_door_link_message }
    originId           = { value = azurerm_cdn_frontdoor_origin.storage[0].id }
  })

  tags = local.tags

  depends_on = [azurerm_cdn_frontdoor_route.storage]
}

# -----------------------------------------------------------------------------
# Web application firewall
# -----------------------------------------------------------------------------

resource "azurerm_cdn_frontdoor_firewall_policy" "this" {
  count = var.enable_waf && local.cdn_enabled ? 1 : 0

  name                = "${local.compact_prefix}waf"
  resource_group_name = azurerm_resource_group.this.name
  sku_name            = local.front_door_sku
  enabled             = true
  mode                = "Prevention"

  managed_rule {
    type    = "Microsoft_DefaultRuleSet"
    version = "2.1"
    action  = "Block"
  }

  managed_rule {
    type    = "Microsoft_BotManagerRuleSet"
    version = "1.1"
    action  = "Block"
  }

  tags = local.tags
}

resource "azurerm_cdn_frontdoor_security_policy" "this" {
  count = var.enable_waf && local.cdn_enabled ? 1 : 0

  name                     = "${var.name_prefix}-waf"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.this[0].id

  security_policies {
    firewall {
      cdn_frontdoor_firewall_policy_id = azurerm_cdn_frontdoor_firewall_policy.this[0].id

      association {
        patterns_to_match = ["/*"]

        domain {
          cdn_frontdoor_domain_id = azurerm_cdn_frontdoor_endpoint.this[0].id
        }
      }
    }
  }
}

# Without Front Door the policy is regional: attach it to the Application
# Gateway that publishes the workload (see the waf_id output).
resource "azurerm_web_application_firewall_policy" "regional" {
  count = var.enable_waf && !local.cdn_enabled ? 1 : 0

  name                = "${var.name_prefix}-waf"
  location            = azurerm_resource_group.this.location
  resource_group_name = azurerm_resource_group.this.name

  policy_settings {
    enabled            = true
    mode               = "Prevention"
    request_body_check = true
  }

  managed_rules {
    managed_rule_set {
      type    = "Microsoft_DefaultRuleSet"
      version = "2.1"
    }

    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.1"
    }
  }

  tags = local.tags
}

{
  "values": {
    "name": "sample-infrastructure",
    "description": "The sample service's \"web\" stack: network, database and storage",
    "owner": "group:default/platform-team",
    "cloud_provider": "aws",
    "repoUrl": "github.com?owner=example-org&repo=sample-infrastructure",
    "infrastructure_type": "web-application",
    "enable_networking": true,
    "enable_database": true,
    "database_type": "postgresql",
    "enable_storage": true,
    "enable_cdn": false,
    "enable_kubernetes": false,
    "kubernetes_version": "default",
    "node_instance_type": "medium",
    "enable_autoscaling": true,
    "min_nodes": 2,
    "max_nodes": 10,
    "enable_security_group_rules": true,
    "enable_waf": false,
    "enable_secrets_manager": true,
    "enable_kms": true,
    "enable_backup": true,
    "compliance_framework": "none",
    "enable_monitoring": true,
    "monitoring_solution": "native",
    "enable_alerting": true,
    "log_retention_days": 30,
    "environments": ["staging", "production"],
    "enable_disaster_recovery": false,
    "enable_cost_optimization": true,
    "terraform_version": ">= 1.10",
    "region": "us-east-1"
  }
}

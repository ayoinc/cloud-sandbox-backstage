{
  "project_name": ${{ values.projectName | dump }},
  "component_name": ${{ values.componentName | dump }},
  "owner": ${{ values.owner | dump }},
  "environment": ${{ values.environment | dump }},
  "region": ${{ values.region | dump }},
  "tags": ${{ (values.tags or {}) | dump }},

  "enable_networking": ${{ values.enable_networking | dump }},
  "enable_compute": ${{ values.enable_compute | dump }},
  "enable_containers": ${{ values.enable_containers | dump }},
  "enable_storage": ${{ values.enable_storage | dump }},
  "enable_database": ${{ values.enable_database | dump }},
  "enable_security": ${{ values.enable_security | dump }},
  "enable_monitoring": ${{ values.enable_monitoring | dump }},
  "enable_analytics": ${{ values.enable_analytics | dump }},
  "enable_integration": ${{ values.enable_integration | dump }},
  "enable_ai_ml": ${{ values.enable_ai_ml | dump }},

  "vpc_cidr": ${{ values.vpc_cidr | dump }},
  "subnet_configurations": ${{ (values.subnet_configurations or []) | dump }},
  "enable_nat_gateway": ${{ values.enable_nat_gateway | dump }},
  "enable_vpn_gateway": ${{ values.enable_vpn_gateway | dump }},
  "enable_transit_gateway": ${{ values.enable_transit_gateway | dump }},

  "instance_type": ${{ values.instance_type | dump }},
  "ebs_volume_size": ${{ values.ebs_volume_size | dump }},

  "eks_version": ${{ values.eks_version | dump }},
  "eks_node_group_instance_types": ${{ values.eks_node_group_instance_types | dump }},
  "eks_desired_nodes": ${{ values.eks_desired_nodes | dump }},
  "eks_min_nodes": ${{ values.eks_min_nodes | dump }},
  "eks_max_nodes": ${{ values.eks_max_nodes | dump }},

  "s3_bucket_encryption": ${{ values.s3_bucket_encryption | dump }},
  "s3_versioning": ${{ values.s3_versioning | dump }},
  "enable_efs": ${{ values.enable_efs | dump }},

  "rds_instance_class": ${{ values.rds_instance_class | dump }},
  "rds_allocated_storage": ${{ values.rds_allocated_storage | dump }},
  "rds_backup_retention": ${{ values.rds_backup_retention | dump }},
  "rds_multi_az": ${{ (values.environment in ["prod", "dr"]) | dump }},
  "deletion_protection": ${{ (values.environment in ["prod", "dr"]) | dump }},
  "enable_dynamodb": ${{ values.enable_dynamodb | dump }},
  "enable_elasticache": ${{ values.enable_elasticache | dump }}
}

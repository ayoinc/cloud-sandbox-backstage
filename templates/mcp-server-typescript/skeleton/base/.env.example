# Transport: http (Streamable HTTP) or stdio. The --stdio flag selects stdio too.
MCP_TRANSPORT=http

# Address and port of the HTTP transport.
HOST=127.0.0.1
PORT=${{ values.port }}

# Bearer token clients send in the Authorization header, at least 32 characters.
# Required when HOST is not a loopback address. Generate one with:
#   openssl rand -base64 32
MCP_AUTH_TOKEN=

# Comma-separated host names accepted in the Host header, for example the name
# the server has behind a proxy. Loopback names are accepted by default when
# HOST is a loopback address.
MCP_ALLOWED_HOSTS=

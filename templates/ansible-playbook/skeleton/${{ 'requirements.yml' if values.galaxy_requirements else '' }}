---
# Ansible Galaxy requirements
# Install with: ansible-galaxy install -r requirements.yml

{%- if values.collections | length %}
collections:
{%- for collection in values.collections %}
  - name: ${{ collection }}
{%- endfor %}
{%- else %}
collections: []
{%- endif %}

# Roles from Galaxy or Git, for example:
#   - name: geerlingguy.docker
#     version: '7.4.1'
#   - name: https://github.com/example/ansible-role.git
#     type: git
#     version: main
roles: []

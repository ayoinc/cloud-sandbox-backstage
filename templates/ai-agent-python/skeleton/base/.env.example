# Copy to .env and run with:  uv run --env-file .env uvicorn --factory agent.main:app --reload
# Never commit .env. In deployed environments these come from a secret manager.
{% if values.provider == 'anthropic' %}
# Credential of the model provider, read by the Anthropic SDK.
ANTHROPIC_API_KEY=
{%- elif values.provider == 'openai' %}
# Credential of the model provider, read by the OpenAI SDK.
OPENAI_API_KEY=
{%- else %}
# Amazon Bedrock uses the AWS credentials of the environment: the role of the
# workload when deployed, an SSO session or profile on a workstation
# (aws sso login, then AWS_PROFILE below). Do not put access keys here.
AWS_REGION=${{ values.aws_region }}
# AWS_PROFILE=
{%- endif %}

# Model id sent to the provider.
AGENT_MODEL=${{ values.model }}

# Limits of one request.
AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=20

# Bearer token callers of this service must present, at least 32 characters.
# Unset: the API is open, which is only acceptable behind an authenticating gateway.
AGENT_API_TOKEN=

# OpenTelemetry: traces are exported when an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

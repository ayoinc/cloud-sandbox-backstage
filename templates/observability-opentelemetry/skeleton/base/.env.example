# Copy to .env and fill in. Never commit .env.
{%- if values.deployment == 'kubernetes-helm' %}
# On Kubernetes these values are the keys of the Secret "${{ values.name }}-backend";
# scripts/create-secret.sh creates it from this file.
{%- endif %}

# Endpoint of the observability backend.
{%- if values.exporter_protocol == 'otlp_http' %}
# OTLP over HTTP: the base URL, without /v1/traces.
OTLP_ENDPOINT=
{%- else %}
# OTLP over gRPC: host and port, for example otlp.backend.internal:4317.
OTLP_ENDPOINT=
# The connection uses TLS. Set to true only for a backend inside a trusted
# network that does not offer TLS.
OTLP_INSECURE=false
{%- endif %}

# Value of the Authorization header the backend expects, for example
# "Bearer <token>" or "Basic <base64>". Leave empty if it needs none.
OTLP_AUTHORIZATION=
{%- if values.metrics_exporter == 'prometheus-remote-write' %}

# Prometheus remote-write endpoint, including the path (for example .../api/v1/write).
PROMETHEUS_REMOTE_WRITE_ENDPOINT=
PROMETHEUS_REMOTE_WRITE_AUTHORIZATION=
{%- endif %}

# Added to all telemetry as deployment.environment.name unless the sender set it.
DEPLOYMENT_ENVIRONMENT=production

{%- set password_auth = values.auth_type in ['jwt', 'basic-auth'] -%}
# Copy to .env to change the defaults. Every line shows the default value.

# development, staging or production.{% if values.database_type in ['postgresql', 'mysql'] or values.auth_type != 'none' %} With production the service refuses to
# start while a secret below still has its development default.{% endif %}
APP_ENV=development
{%- if values.enable_logging %}
LOG_LEVEL=INFO
{%- endif %}
{%- if values.sql %}

# SQLAlchemy URL of the database
{%- if values.database_type == 'postgresql' %}
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
{%- elif values.database_type == 'mysql' %}
DATABASE_URL=mysql+aiomysql://app:app@localhost:3306/app
{%- else %}
DATABASE_URL=sqlite+aiosqlite:///./app.db
{%- endif %}
{%- endif %}
{%- if values.enable_caching %}

# Without REDIS_URL items are cached in the memory of each process.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
{%- endif %}
{%- if password_auth %}

# The user allowed to call the items API
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
{%- endif %}
{%- if values.auth_type == 'jwt' %}
# Key that signs the tokens (HS256), at least 32 characters
JWT_SECRET=development-only-secret-replace-me-0123456789
JWT_EXPIRE_MINUTES=30
{%- endif %}
{%- if values.auth_type == 'api-key' %}

# JSON list of the keys accepted in the X-API-Key header
API_KEYS=["dev-api-key"]
{%- endif %}
{%- if values.enable_rate_limiting %}

# Requests allowed per client address
RATE_LIMIT=100/minute
{%- endif %}
{%- if values.enable_cors %}

# JSON list of the browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]
{%- endif %}

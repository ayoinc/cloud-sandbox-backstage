# Copy to .env.local to override the defaults while developing.
# Vite only exposes variables that start with VITE_ to the application.

# Base URL of the backend API compiled into the bundle.
VITE_API_BASE_URL=${{ values.api_base_url }}
{%- if values.enable_mock_api %}

# Set to true to answer API requests in the browser with the Mock Service
# Worker handlers in src/mocks/ while running `npm run dev`.
VITE_ENABLE_MOCK_API=false
{%- endif %}
{%- if values.enable_monitoring %}

# URL that receives Web Vitals measurements as JSON (POST). When it is empty
# the measurements are written to the browser console.
VITE_VITALS_ENDPOINT=
{%- endif %}

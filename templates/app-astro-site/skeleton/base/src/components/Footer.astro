---
import { href } from '../lib/paths';
import { SITE } from '../site';

const year = new Date().getUTCFullYear();
---

<footer class="border-t border-slate-200">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-4 py-6 text-sm text-slate-500">
    <p>
      &copy; {year} {SITE.title}
    </p>
    <a href={href('rss.xml')} class="hover:text-slate-900">
      RSS feed
    </a>
  </div>
</footer>

# Example values for the GCP kubernetes module: a Standard cluster with every
# optional feature enabled. Remove node_pools and set enable_autopilot = true
# for an Autopilot cluster.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

network_name        = "acme-platform-dev-vpc"
subnet_name         = "acme-platform-dev-private"
pods_range_name     = "acme-platform-dev-pods"
services_range_name = "acme-platform-dev-services"

enable_autopilot    = false
release_channel     = "STABLE"
deletion_protection = true

enable_private_endpoint = false
master_ipv4_cidr_block  = "172.16.0.0/28"
master_authorized_networks = [
  {
    cidr_block   = "203.0.113.0/24"
    display_name = "office"
  },
]

kms_key_id             = "projects/acme-platform-dev/locations/us-central1/keyRings/acme-platform-dev/cryptoKeys/acme-platform-dev-key"
maintenance_start_time = "02:00"

system_node_count   = 1
system_machine_type = "e2-standard-2"

node_pools = {
  general = {
    machine_type = "e2-standard-4"
    min_count    = 1
    max_count    = 5
  }
  batch = {
    machine_type = "n2-standard-8"
    min_count    = 0
    max_count    = 10
    spot         = true
    labels       = { workload = "batch" }
    taints = [
      {
        key    = "workload"
        value  = "batch"
        effect = "NO_SCHEDULE"
      },
    ]
  }
}

enable_artifact_registry                  = true
artifact_registry_immutable_tags          = true
artifact_registry_keep_count              = 20
artifact_registry_untagged_retention_days = 14

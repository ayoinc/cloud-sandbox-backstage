# Example values for the GCP database module with every optional feature enabled.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

network_id               = "projects/acme-platform-dev/global/networks/acme-platform-dev-vpc"
private_ip_range         = "acme-platform-dev-psa"
private_ip_prefix_length = 20

database_version    = "POSTGRES_17"
edition             = "ENTERPRISE"
tier                = "db-custom-2-7680"
high_availability   = true
disk_size_gb        = 50
kms_key_id          = "projects/acme-platform-dev/locations/us-central1/keyRings/acme-platform-dev/cryptoKeys/acme-platform-dev-key"
deletion_protection = true

database_name = "orders"
user_name     = "orders_app"

database_flags = {
  max_connections = "200"
}

backup_enabled    = true
backup_start_time = "02:00"
retained_backups  = 14

maintenance_window_day  = 7
maintenance_window_hour = 4

query_insights_enabled = true

enable_redis         = true
redis_tier           = "STANDARD_HA"
redis_memory_size_gb = 2
redis_version        = "REDIS_7_2"

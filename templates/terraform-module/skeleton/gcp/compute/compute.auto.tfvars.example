# Example values for the GCP compute module with every optional feature enabled.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

zone             = "us-central1-a"
additional_zones = ["us-central1-b", "us-central1-c"]

network_name = "acme-platform-dev-vpc"
subnet_name  = "acme-platform-dev-private"

machine_type      = "e2-standard-2"
source_image      = "debian-cloud/debian-12"
boot_disk_size_gb = 30
boot_disk_type    = "pd-ssd"
data_disk_size_gb = 50
kms_key_id        = "projects/acme-platform-dev/locations/us-central1/keyRings/acme-platform-dev/cryptoKeys/acme-platform-dev-key"
enable_spot       = true

metadata = {
  app-version = "1.4.2"
}

service_account_roles = [
  "roles/logging.logWriter",
  "roles/monitoring.metricWriter",
  "roles/artifactregistry.reader",
]

app_port                       = 8080
health_check_path              = "/healthz"
auto_healing_initial_delay_sec = 300

min_replicas               = 2
max_replicas               = 6
target_cpu_utilization     = 0.65
autoscaler_cooldown_period = 120

enable_iap_ssh    = true
app_source_ranges = ["10.2.16.0/20"]

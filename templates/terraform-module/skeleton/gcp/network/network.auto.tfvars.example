# Example values for the GCP network module with every optional feature enabled.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

network_cidr   = "10.2.0.0/16"
subnet_newbits = 4
routing_mode   = "GLOBAL"

enable_flow_logs  = true
flow_log_sampling = 0.5

enable_gke_secondary_ranges = true
gke_pods_cidr               = "100.64.0.0/14"
gke_services_cidr           = "100.68.0.0/20"

enable_nat   = true
nat_ip_count = 2

enable_iap_ssh    = true
web_source_ranges = ["203.0.113.0/24"]

enable_private_service_access        = true
private_service_access_prefix_length = 20

enable_private_dns = true
private_dns_domain = "internal.acme.example."

enable_shared_vpc_host = true

# Example values for the GCP storage module with every optional feature enabled.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

kms_key_id       = "projects/acme-platform-dev/locations/us-central1/keyRings/acme-platform-dev/cryptoKeys/acme-platform-dev-key"
grant_kms_access = true

bucket_suffix              = "assets"
storage_class              = "STANDARD"
enable_versioning          = true
soft_delete_retention_days = 14
force_destroy              = false

lifecycle_rules = [
  {
    action        = "SetStorageClass"
    storage_class = "NEARLINE"
    age_days      = 30
  },
  {
    action                = "Delete"
    days_since_noncurrent = 90
    with_state            = "ARCHIVED"
  },
]

cors_config = {
  origins = ["https://app.acme.example"]
  methods = ["GET", "HEAD"]
}

logging_bucket = "acme-platform-dev-access-logs"

retention_period_seconds   = 86400
retention_policy_is_locked = false

bucket_viewers  = ["group:analysts@acme.example"]
bucket_creators = ["serviceAccount:uploader@acme-platform-dev.iam.gserviceaccount.com"]
bucket_writers  = ["serviceAccount:acme-platform-dev-app@acme-platform-dev.iam.gserviceaccount.com"]

enable_filestore            = true
filestore_tier              = "BASIC_HDD"
filestore_capacity_gb       = 1024
filestore_zone              = "us-central1-b"
filestore_share_name        = "shared"
filestore_network           = "acme-platform-dev-vpc"
filestore_allowed_ip_ranges = ["10.2.0.0/20"]

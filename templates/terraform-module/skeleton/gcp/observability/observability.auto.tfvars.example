# Example values for the GCP observability module with every optional feature
# enabled. Pass slack_auth_token and pagerduty_service_key through the
# TF_VAR_slack_auth_token and TF_VAR_pagerduty_service_key environment
# variables instead of committing them.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

notification_email = "platform-oncall@acme.example"
slack_channel_name = "#platform-alerts"

enable_log_sink          = true
log_filter               = "severity>=WARNING"
log_archive_days         = 30
log_retention_days       = 365
force_destroy_log_bucket = false
kms_key_id               = "projects/acme-platform-dev/locations/us-central1/keyRings/acme-platform-dev/cryptoKeys/acme-platform-dev-key"

enable_alerts                         = true
cpu_threshold_percent                 = 80
memory_threshold_percent              = 85
alert_duration_seconds                = 300
error_log_notification_period_seconds = 600

uptime_check_host            = "app.acme.example"
uptime_check_path            = "/healthz"
uptime_check_period_seconds  = 60
uptime_check_timeout_seconds = 10

enable_dashboard       = true
dashboard_display_name = "Acme platform (dev)"

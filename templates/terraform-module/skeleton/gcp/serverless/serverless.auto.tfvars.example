# Example values for the GCP serverless module: a Cloud Run service with every
# optional feature enabled. For a Cloud Function set deploy_type = "function"
# together with source_archive_path, runtime and entry_point.

project_name = "acme-platform"
environment  = "dev"
project_id   = "acme-platform-dev"
region       = "us-central1"

labels = {
  team = "platform"
}

service_name = "orders"
description  = "Orders API"
deploy_type  = "run"

container_image     = "us-central1-docker.pkg.dev/acme-platform-dev/acme-platform-dev-images/orders:1.4.2"
container_port      = 8080
health_check_path   = "/healthz"
cpu_idle            = false
deletion_protection = true

memory          = "1Gi"
cpu             = "2"
timeout_seconds = 120
min_instances   = 1
max_instances   = 20
max_concurrency = 100

environment_variables = {
  LOG_LEVEL = "info"
}

secret_environment_variables = {
  DATABASE_URL = {
    secret = "acme-platform-dev-database-url"
  }
}

vpc_connector = "projects/acme-platform-dev/locations/us-central1/connectors/acme-dev"
vpc_egress    = "PRIVATE_RANGES_ONLY"
ingress       = "internal-and-cloud-load-balancing"

allow_unauthenticated = false
invoker_members       = ["group:orders-clients@acme.example"]

service_account_roles = [
  "roles/logging.logWriter",
  "roles/monitoring.metricWriter",
  "roles/cloudtrace.agent",
  "roles/cloudsql.client",
]

kms_key_id = "projects/acme-platform-dev/locations/us-central1/keyRings/acme-platform-dev/cryptoKeys/acme-platform-dev-key"

enable_pubsub                     = true
pubsub_message_retention_duration = "604800s"
pubsub_ack_deadline_seconds       = 120

schedule_cron      = "0 6 * * *"
schedule_time_zone = "Europe/London"

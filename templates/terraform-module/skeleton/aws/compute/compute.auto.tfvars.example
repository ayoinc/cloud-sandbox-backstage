# -----------------------------------------------------------------------------
# AWS Compute Module - Example tfvars (every optional feature enabled)
# -----------------------------------------------------------------------------

project_name = "myproject"
environment  = "dev"

# Network Configuration
vpc_id     = "vpc-0123456789abcdef0"
subnet_ids = ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"]

# Instance Configuration
instance_type    = "t3.small"
ami_id           = "ami-0123456789abcdef0"
root_volume_size = 30

# Auto Scaling Configuration
min_size         = 2
max_size         = 6
desired_capacity = 2

# Access
ssh_allowed_cidrs              = ["10.0.0.0/16"]
app_ports                      = [8080]
app_allowed_cidrs              = ["10.0.0.0/16"]
app_allowed_security_group_ids = ["sg-0123456789abcdef0"]

# Load Balancer Integration
target_group_arns         = ["arn:aws:elasticloadbalancing:eu-west-2:123456789012:targetgroup/myproject-dev/0123456789abcdef"]
health_check_type         = "ELB"
health_check_grace_period = 300

# Monitoring and Scaling
enable_detailed_monitoring = true
scale_up_threshold         = 70
scale_down_threshold       = 25
log_retention_days         = 90

# Tags
tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

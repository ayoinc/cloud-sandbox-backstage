# -----------------------------------------------------------------------------
# AWS Security Module - Example tfvars (every optional feature enabled)
# -----------------------------------------------------------------------------

project_name = "myproject"
environment  = "dev"

# KMS
kms_multi_region = true

# Bastion security group
vpc_id                = "vpc-0123456789abcdef0"
enable_bastion_sg     = true
bastion_allowed_cidrs = ["203.0.113.0/24"]

# WAF
enable_waf     = true
waf_rate_limit = 2000

# Tags
tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

# -----------------------------------------------------------------------------
# AWS Database Module - Example tfvars (every optional feature enabled)
# -----------------------------------------------------------------------------

project_name = "myproject"
environment  = "dev"

# Network Configuration
vpc_id                  = "vpc-0123456789abcdef0"
subnet_ids              = ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"]
allowed_security_groups = ["sg-0123456789abcdef0"]
allowed_cidr_blocks     = ["10.0.0.0/16"]

kms_key_arn = "arn:aws:kms:eu-west-2:123456789012:key/11111111-2222-3333-4444-555555555555"

# RDS Configuration
engine                = "postgres"
engine_version        = "17"
instance_class        = "db.t3.small"
allocated_storage     = 50
max_allocated_storage = 200
storage_type          = "gp3"

db_name     = "myapp"
db_username = "dbadmin"

# High Availability
multi_az = true

# Maintenance & Backup
maintenance_window      = "sun:04:00-sun:05:00"
backup_window           = "03:00-04:00"
backup_retention_period = 14
deletion_protection     = true

# Monitoring
performance_insights_enabled   = true
performance_insights_retention = 7
enhanced_monitoring_interval   = 60
cloudwatch_logs_exports        = ["postgresql", "upgrade"]

db_parameters = [
  {
    name  = "log_min_duration_statement"
    value = "500"
  }
]

# ElastiCache Configuration
enable_elasticache       = true
cache_engine_version     = "7.1"
cache_node_type          = "cache.t3.small"
cache_num_nodes          = 2
cache_snapshot_retention = 7

# Tags
tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

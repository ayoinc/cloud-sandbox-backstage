# -----------------------------------------------------------------------------
# AWS Serverless Module - Example tfvars (every optional feature enabled)
# -----------------------------------------------------------------------------

project_name = "myproject"
environment  = "dev"

kms_key_arn = "arn:aws:kms:eu-west-2:123456789012:key/11111111-2222-3333-4444-555555555555"

# VPC Configuration
enable_vpc = true
vpc_id     = "vpc-0123456789abcdef0"
subnet_ids = ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"]

# Lambda Configuration (the built-in handler is deployed because no
# deployment_package or image_uri is given)
package_type = "Zip"
runtime      = "python3.13"
handler      = "handler.main"
memory_size  = 512
timeout      = 30

environment_variables = {
  LOG_LEVEL = "INFO"
}

reserved_concurrency    = 20
provisioned_concurrency = 2
enable_xray             = true
log_retention_days      = 30

# API Gateway Configuration
enable_api_gateway   = true
cors_allowed_origins = ["https://app.example.com"]
api_throttle_burst   = 100
api_throttle_rate    = 50

# EventBridge Schedule
schedule_expression = "rate(1 hour)"

# SQS Configuration
enable_sqs     = true
enable_dlq     = true
sqs_batch_size = 10

# Tags
tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

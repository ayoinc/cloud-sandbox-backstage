# -----------------------------------------------------------------------------
# Azure Network Module - Example tfvars
# -----------------------------------------------------------------------------

project_name = "myproject"
environment  = "dev"
location     = "eastus2"

# Existing resource group. Leave null to let the module create one.
resource_group_name = "myproject-dev-rg"

# Address plan: four tiers (public, private, database, kubernetes) of /20 subnets
vnet_cidr      = "10.0.0.0/16"
subnet_newbits = 4
subnet_count   = 1

# Public subnets stay closed until an allow-list is given
public_ingress_cidrs = ["203.0.113.0/24"]
public_ingress_ports = [80, 443]

# Ports the application tiers may reach on the database subnets
database_ports = [5432]

# NAT Gateway for outbound traffic from the private and kubernetes subnets
enable_nat             = true
nat_idle_timeout       = 10
enable_zone_redundancy = true

enable_service_endpoints = true

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

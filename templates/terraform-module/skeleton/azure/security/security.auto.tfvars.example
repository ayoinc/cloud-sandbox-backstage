# -----------------------------------------------------------------------------
# Azure Security Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"

# Key Vault
key_vault_sku                   = "standard"
enable_purge_protection         = true
soft_delete_retention_days      = 90
enabled_for_deployment          = false
enabled_for_disk_encryption     = true
enabled_for_template_deployment = false
enable_rbac_authorization       = true

# Firewall: deny by default, admit the machine running Terraform and the application subnet
network_acls = {
  default_action = "Deny"
  bypass         = "AzureServices"
  ip_rules       = ["203.0.113.10/32"]
  virtual_network_subnet_ids = [
    "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-private-1"
  ]
}

# Customer-managed encryption key with automatic rotation
create_encryption_key           = true
rbac_propagation_wait           = "90s"
encryption_key_type             = "RSA"
encryption_key_size             = 4096
encryption_key_curve            = "P-256"
key_expiration_period           = "P365D"
key_rotation_time_before_expiry = "P30D"
key_notify_before_expiry        = "P30D"

# Security log workspace
log_analytics_sku  = "PerGB2018"
log_retention_days = 90

# Microsoft Defender for Cloud (subscription-wide)
enable_defender         = true
defender_resource_types = ["Arm", "KeyVaults", "StorageAccounts"]

# Application Insights
enable_application_insights              = true
application_insights_type                = "web"
application_insights_retention_days      = 90
application_insights_sampling_percentage = 100
application_insights_disable_ip_masking  = false
application_insights_local_auth_disabled = true
application_insights_internet_ingestion  = true
application_insights_internet_query      = true

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

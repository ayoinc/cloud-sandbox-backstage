# -----------------------------------------------------------------------------
# Azure Storage Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"

# Storage account
account_kind                     = "StorageV2"
account_tier                     = "Standard"
replication_type                 = "GRS"
enable_infrastructure_encryption = true
enable_versioning                = true
delete_retention_days            = 14
container_delete_retention_days  = 14

# Private blob containers
container_names = ["data", "logs", "backups"]

# Lifecycle management
lifecycle_rules = [
  {
    name                                 = "archive-old-blobs"
    base_blob_tier_to_cool_after_days    = 30
    base_blob_tier_to_archive_after_days = 90
    snapshot_delete_after_days           = 30
    version_delete_after_days            = 90
  },
  {
    name                        = "expire-logs"
    prefix_match                = ["logs/"]
    base_blob_delete_after_days = 365
  }
]

# Azure Files share
enable_file_share      = true
file_share_quota_gb    = 100
file_share_access_tier = "Hot"

# Network: deny by default, admit listed subnets and public IP ranges
public_network_access_enabled = true
network_default_action        = "Deny"
allowed_subnet_ids = [
  "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-private-1"
]
allowed_ip_ranges = ["203.0.113.0/24"]

# Blob diagnostics
log_analytics_workspace_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.OperationalInsights/workspaces/myproject-dev-law"

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

# -----------------------------------------------------------------------------
# Azure Serverless Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"

# Plan: Y1 = Consumption, EP1-EP3 = Elastic Premium, B/S/P = dedicated
sku_name                     = "EP1"
maximum_elastic_worker_count = 10

# Runtime
runtime_stack   = "python"
runtime_version = "3.12"

app_settings = {
  LOG_LEVEL = "INFO"
}

cors_allowed_origins     = ["https://app.example.com"]
cors_support_credentials = true
health_check_path        = "/api/health"

# Storage
storage_replication_type = "ZRS"

# VNet integration (Elastic Premium and dedicated plans). The subnet must be
# delegated to Microsoft.Web/serverFarms and have the Microsoft.Storage service endpoint.
vnet_integration_subnet_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-functions"

# Application Insights
create_application_insights         = true
log_analytics_workspace_id          = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.OperationalInsights/workspaces/myproject-dev-law"
application_insights_retention_days = 90

# API Management in front of the function app
enable_api_management      = true
apim_publisher_name        = "Platform Team"
apim_publisher_email       = "platform@example.com"
apim_sku_name              = "Developer_1"
apim_subnet_id             = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-apim"
apim_api_path              = "v1"
apim_subscription_required = true
apim_http_methods          = ["GET", "POST", "PUT", "PATCH", "DELETE"]

# Service Bus queue
enable_service_bus              = true
service_bus_sku                 = "Standard"
service_bus_capacity            = 1
service_bus_max_delivery_count  = 10
service_bus_lock_duration       = "PT1M"
service_bus_max_size_mb         = 1024
service_bus_message_ttl         = "P14D"
service_bus_enable_partitioning = false

# Event Grid topic. Create the subscription once the trigger function is deployed.
enable_event_grid                  = true
event_grid_public_access           = true
event_grid_local_auth_enabled      = false
event_grid_create_subscription     = true
event_grid_function_name           = "EventGridTrigger"
event_grid_max_events_per_batch    = 1
event_grid_preferred_batch_size_kb = 64

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

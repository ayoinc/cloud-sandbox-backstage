# -----------------------------------------------------------------------------
# Azure Compute Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"
subnet_id           = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-private-1"

# Virtual machines
vm_size = "Standard_D2s_v5"
source_image = {
  publisher = "Canonical"
  offer     = "ubuntu-24_04-lts"
  sku       = "server"
  version   = "latest"
}
zones                        = ["1", "2", "3"]
instances_min                = 2
instances_max                = 6
instances_default            = 2
os_disk_size_gb              = 64
os_disk_storage_account_type = "Premium_LRS"
enable_trusted_launch        = true

# Needs the Microsoft.Compute/EncryptionAtHost feature registered on the subscription
enable_encryption_at_host = true

# Admin access. Replace the sample key with your own RSA public key, or remove
# the line to have a key pair generated.
admin_username = "azureuser"
ssh_public_key = "ssh-rsa  platform@example.com"

# Network access
ssh_allowed_cidrs     = ["10.0.0.0/16"]
ingress_allowed_cidrs = ["10.0.0.0/16", "203.0.113.0/24"]
ingress_ports         = [80, 443]
health_check_port     = 80
enable_public_ip      = true

# Upgrades and autoscaling
enable_automatic_os_upgrade      = true
scale_out_cpu_threshold          = 70
scale_in_cpu_threshold           = 30
scale_out_memory_threshold_bytes = 1073741824
autoscale_notification_emails    = ["platform@example.com"]

# Azure Monitor data collection rule
data_collection_rule_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Insights/dataCollectionRules/myproject-dev-dcr"

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

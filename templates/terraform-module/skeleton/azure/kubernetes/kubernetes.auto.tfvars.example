# -----------------------------------------------------------------------------
# Azure Kubernetes Service (AKS) Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"

# Node subnet (from the network module)
subnet_id                = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-kubernetes-1"
node_resource_group_name = "myproject-dev-aks-nodes-rg"

# Cluster. Leave kubernetes_version unset to get the current AKS default.
automatic_upgrade_channel = "stable"
node_os_upgrade_channel   = "NodeImage"
sku_tier                  = "Standard"

# API server: private by default. A public API server needs an allow-list.
private_cluster_enabled         = false
api_server_authorized_ip_ranges = ["203.0.113.0/24"]

default_node_pool = {
  name                         = "system"
  vm_size                      = "Standard_D2s_v5"
  node_count                   = 3
  min_count                    = 2
  max_count                    = 5
  enable_auto_scaling          = true
  max_pods                     = 30
  os_disk_size_gb              = 128
  os_disk_type                 = "Managed"
  os_sku                       = "AzureLinux"
  zones                        = ["1", "2", "3"]
  only_critical_addons_enabled = true
  max_surge                    = "33%"
}

additional_node_pools = [
  {
    name                = "user"
    vm_size             = "Standard_D4s_v5"
    min_count           = 1
    max_count           = 10
    enable_auto_scaling = true
    zones               = ["1", "2", "3"]
    node_labels = {
      "workload-type" = "general"
    }
  },
  {
    name                = "spot"
    vm_size             = "Standard_D4s_v5"
    min_count           = 0
    max_count           = 20
    enable_auto_scaling = true
    priority            = "Spot"
    eviction_policy     = "Delete"
    spot_max_price      = -1
    node_labels = {
      "workload-type" = "batch"
    }
  }
]

# Networking: Azure CNI Overlay with Cilium
network_plugin_mode = "overlay"
network_policy      = "cilium"
dns_service_ip      = "172.16.0.10"
service_cidr        = "172.16.0.0/16"
pod_cidr            = "10.244.0.0/16"
outbound_type       = "userAssignedNATGateway"

# Container Insights
log_analytics_workspace_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.OperationalInsights/workspaces/myproject-dev-law"

# Container registry the nodes pull from
acr_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.ContainerRegistry/registries/myprojectdevacr"

# Security and identity
azure_policy_enabled               = true
workload_identity_enabled          = true
key_vault_secrets_provider_enabled = true
secret_rotation_enabled            = true
secret_rotation_interval           = "2m"

# Microsoft Entra ID sign-in and Azure RBAC for the Kubernetes API
azure_ad_rbac_enabled  = true
azure_rbac_enabled     = true
local_account_disabled = true
admin_group_object_ids = ["11111111-1111-1111-1111-111111111111"]

auto_scaler_profile = {
  balance_similar_node_groups = true
  expander                    = "least-waste"
  scale_down_unneeded         = "10m"
}

maintenance_window = {
  allowed = [
    {
      day   = "Sunday"
      hours = [0, 1, 2, 3, 4, 5]
    }
  ]
}

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

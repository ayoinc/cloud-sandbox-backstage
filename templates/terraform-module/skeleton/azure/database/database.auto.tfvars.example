# -----------------------------------------------------------------------------
# Azure Database Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"

# Subnet delegated to Microsoft.DBforPostgreSQL/flexibleServers
subnet_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-database-1"
vnet_id   = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev"

# Subnet without delegation for the Redis private endpoint
private_endpoint_subnet_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Network/virtualNetworks/vnet-myproject-dev/subnets/snet-myproject-dev-private-1"

# Credentials in Key Vault
store_credentials_in_key_vault = true
key_vault_id                   = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.KeyVault/vaults/kvmyprojectdev"
secret_expiration_date         = "2030-01-01T00:00:00Z"

# PostgreSQL server
postgresql_version = "17"
sku_name           = "GP_Standard_D2ds_v5"
storage_mb         = 65536
auto_grow_enabled  = true
admin_username     = "psqladmin"
database_name      = "appdb"
database_collation = "en_US.utf8"
database_charset   = "UTF8"
availability_zone  = "1"

# Backups
backup_retention_days = 14
geo_redundant_backup  = true

# High availability (General Purpose and Memory Optimized SKUs)
enable_high_availability  = true
high_availability_mode    = "ZoneRedundant"
standby_availability_zone = "2"

# Authentication
enable_password_auth = true
enable_aad_auth      = true
tenant_id            = "00000000-0000-0000-0000-000000000000"
aad_administrator = {
  object_id      = "11111111-1111-1111-1111-111111111111"
  principal_name = "database-admins"
  principal_type = "Group"
}

# Server parameters
postgresql_configurations = {
  "azure.extensions"           = "PG_TRGM,BTREE_GIST,UUID-OSSP"
  "connection_throttle.enable" = "on"
  "log_checkpoints"            = "on"
  "log_disconnections"         = "on"
  "require_secure_transport"   = "on"
}

maintenance_window = {
  day_of_week  = 0
  start_hour   = 2
  start_minute = 0
}

# Azure Managed Redis
enable_redis                    = true
redis_sku                       = "Balanced_B1"
redis_high_availability_enabled = true
redis_access_keys_enabled       = true
redis_clustering_policy         = "OSSCluster"
redis_eviction_policy           = "VolatileLRU"
create_redis_private_dns_zone   = true

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

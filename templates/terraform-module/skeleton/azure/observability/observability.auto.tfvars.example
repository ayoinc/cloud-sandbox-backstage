# -----------------------------------------------------------------------------
# Azure Observability Module - Example tfvars
# -----------------------------------------------------------------------------

project_name        = "myproject"
environment         = "dev"
location            = "eastus2"
resource_group_name = "myproject-dev-rg"

# Log Analytics workspace
sku                        = "PerGB2018"
log_retention_days         = 30
daily_quota_gb             = 5
internet_ingestion_enabled = true
internet_query_enabled     = true

# Application Insights
enable_application_insights                    = true
application_insights_type                      = "web"
application_insights_retention_days            = 90
application_insights_daily_cap_gb              = 5
application_insights_disable_cap_notifications = false
application_insights_sampling_percentage       = 100
application_insights_disable_ip_masking        = false

# Container Insights solution for AKS
enable_container_insights = true

# Alert receivers
alert_email             = "platform@example.com"
additional_alert_emails = ["oncall@example.com"]
alert_sms_receivers = [
  {
    name         = "oncall"
    country_code = "1"
    phone_number = "5555550100"
  }
]
alert_webhook_urls = ["https://hooks.example.com/azure-monitor"]
azure_app_push_receivers = [
  {
    name          = "oncall-app"
    email_address = "oncall@example.com"
  }
]

alert_frequency   = "PT5M"
alert_window_size = "PT15M"

# CPU and memory alerts on a virtual machine or scale set
monitored_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Compute/virtualMachineScaleSets/myproject-dev-vmss"
enable_cpu_alert      = true
cpu_threshold         = 80
cpu_alert_severity    = 2
enable_memory_alert   = true
memory_threshold      = 85
memory_alert_severity = 2

# Disk usage alert for machines reporting VM insights data to the workspace
enable_disk_alert   = true
disk_threshold      = 90
disk_alert_severity = 2

# HTTP 5xx alert on an App Service or Function App
http_monitored_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.Web/sites/myproject-dev-func"
enable_http_errors_alert   = true
http_errors_threshold      = 10
http_errors_alert_severity = 1

# Azure Service Health alert for the subscription
enable_service_health_alert = true
service_health_events       = ["Incident", "Maintenance", "Security"]
service_health_locations    = ["East US 2", "Global"]
service_health_services     = []

# Portal dashboard
enable_dashboard = true

# Diagnostic setting for an existing resource
diagnostic_setting_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myproject-dev-rg/providers/Microsoft.KeyVault/vaults/kvmyprojectdev"
diagnostic_log_category_groups = ["allLogs"]
diagnostic_log_categories      = []
diagnostic_metric_categories   = ["AllMetrics"]

tags = {
  Team       = "platform"
  CostCenter = "engineering"
}

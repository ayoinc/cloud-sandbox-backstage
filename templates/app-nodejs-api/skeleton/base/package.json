{
  "name": "${{ values.name }}",
  "version": "1.0.0",
  "description": ${{ values.description | dump }},
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
{%- if values.framework == 'fastify' %}
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0"
{%- else %}
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
{%- endif %}
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
{%- if values.framework != 'fastify' %}
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
{%- endif %}
    "@types/node": "^22.10.0",
{%- if values.framework != 'fastify' %}
    "@types/supertest": "^6.0.2",
{%- endif %}
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
{%- if values.framework != 'fastify' %}
    "supertest": "^7.0.0",
{%- endif %}
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
